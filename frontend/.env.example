# ResQMesh Frontend Environment Variables
# When deploying to Vercel, set VITE_API_URL to your Render backend service URL.
# Example:
# VITE_API_URL=https://resqmesh-backend.onrender.com

VITE_API_URL=
# VITE_WS_URL is optional - if omitted, it auto-converts https://... to wss://...
# VITE_WS_URL=wss://resqmesh-backend.onrender.com
